# RepoSherlock reads process environment variables. This file is a reference.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Absolute directories separated by the system path separator (semicolon on Windows).
REPOSHERLOCK_ALLOWED_ROOTS=
# Explicit, comma-separated loopback frontend origins.
REPOSHERLOCK_FRONTEND_ORIGINS=http://localhost:3000
# Generate a random 32–128 character URL-safe token for the local API.
REPOSHERLOCK_SESSION_TOKEN=
# Optional absolute directory containing local Swagger UI JavaScript and CSS.
REPOSHERLOCK_SWAGGER_ASSETS=
